<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>orca_zed_publisher</name>
  <version>0.0.0</version>
  <description>Publishes an XYZ point cloud with an aligned color buffer, depth, confidence, camera info, IMU/sensor data and (optionally) visual odometry directly from a ZED camera using the ZED SDK C++ API.</description>
  <maintainer email="ramanar2@illinois.edu">ramanaramachandran</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <!-- The ZED SDK and CUDA are installed by the ZED SDK installer, not rosdep -->

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
